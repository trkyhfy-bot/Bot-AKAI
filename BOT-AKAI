# 2. زر الرتبة المخصص المستمر (يحفظ التفاعل بعد إعادة التشغيل)
# ================= ================= =================
class DynamicRoleButton(discord.ui.Button):
    def __init__(self, role_id: int):
        super().__init__(
            label="الحصول على الرتبة / إزالتها", 
            style=discord.ButtonStyle.success, 
            emoji="🏷️",
            custom_id=f"dynamic_role_btn_{role_id}" # Custom ID ثابت لحفظ التفاعل
        )
        self.role_id = role_id

    async def callback(self, interaction: discord.Interaction):
        role = interaction.guild.get_role(self.role_id)

        if not role:
            await interaction.response.send_message("❌ هذه الرتبة غير موجودة في السيرفر!", ephemeral=True)
            return

        try:
            if role in interaction.user.roles:
                await interaction.user.remove_roles(role)
                await interaction.response.send_message(f"➖ تم إزالة رتبة **{role.name}** منك!", ephemeral=True)
            else:
                await interaction.user.add_roles(role)
                await interaction.response.send_message(f"✅ تم إعطاؤك رتبة **{role.name}** بنجاح!", ephemeral=True)
        except discord.Forbidden:
            await interaction.response.send_message("❌ البوت لا يملك صلاحيات كافية لتعديل الرتبة!", ephemeral=True)

class DynamicRoleView(discord.ui.View):
    def __init__(self, role_id: int):
        super().__init__(timeout=None) # يجعل View بدون وقت انتهاء
        self.add_item(DynamicRoleButton(role_id))

