class ColorSelect(discord.ui.Select):
    def __init__(self, color_roles):
        options = [
            discord.SelectOption(
                label=role.name, 
                value=str(role.id), 
                description=f"تغيير لونك إلى {role.name}",
                emoji="🎨"
            )
            for role in color_roles
        ]
        super().__init__(placeholder="🎨 اختر اللون الذي يناسبك...", min_values=1, max_values=1, options=options)

    async def callback(self, interaction: discord.Interaction):
        role_id = int(self.values[0])
        role = interaction.guild.get_role(role_id)

        if not role:
            await interaction.response.send_message("❌ هذه الرتبة غير موجودة!", ephemeral=True)
            return

        old_color_roles = [r for r in interaction.user.roles if r.name.startswith("Color")]
        if old_color_roles:
            await interaction.user.remove_roles(*old_color_roles)

        await interaction.user.add_roles(role)
        await interaction.response.send_message(f"✅ تم تغيير لونك إلى **{role.name}**!", ephemeral=True)

class ColorView(discord.ui.View):
    def __init__(self, color_roles):
        super().__init__(timeout=None)
        self.add_item(ColorSelect(color_roles[:25]))

