@bot.tree.command(name="صنع_الالوان", description="إنشاء رتب الألوان تلقائياً")
async def create_color_roles(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild
    created_count = 0

    for num, hex_code in COLOR_HEX_CODES.items():
        role_name = f"Color {num}"
        existing_role = discord.utils.get(guild.roles, name=role_name)
        if not existing_role:
            try:
                await guild.create_role(name=role_name, color=discord.Color(hex_code))
                created_count += 1
            except Exception:
                pass

    await interaction.followup.send(f"✅ تم إنشاء {created_count} رتبة لون!", ephemeral=True)

@bot.tree.command(name="اضافة_لون", description="إضافة أو تعديل لون رتبة")
@app_commands.describe(role_name="اسم رتبة اللون", hex_code="كود الـ Hex")
async def add_custom_color(interaction: discord.Interaction, role_name: str, hex_code: str):
    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild
    clean_hex = hex_code.replace("#", "")

    try:
        color_int = int(clean_hex, 16)
    except ValueError:
        await interaction.followup.send("❌ كود الـ Hex غير صحيح!", ephemeral=True)
        return

    existing_role = discord.utils.get(guild.roles, name=role_name)
    if existing_role:
        await existing_role.edit(color=discord.Color(color_int))
        await interaction.followup.send(f"✅ تم تحديث **{role_name}**!", ephemeral=True)
    else:
        await guild.create_role(name=role_name, color=discord.Color(color_int))
        await interaction.followup.send(f"✅ تم إنشاء **{role_name}** بنجاح!", ephemeral=True)

