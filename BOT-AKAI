class MatchButton(discord.ui.Button):
    def __init__(self, match_num, p1, p2):
        super().__init__(label=f"🏆 #{match_num}", style=discord.ButtonStyle.primary)
        self.match_num = match_num
        self.p1 = p1
        self.p2 = p2

    async def callback(self, interaction: discord.Interaction):
        if interaction.user.id not in [self.p1.id, self.p2.id]:
            await interaction.response.send_message("❌ أنت لست لاعب في هذه المباراة!", ephemeral=True)
            return
        await interaction.response.send_message(f"✅ تم تأكيدك للمباراة #{self.match_num}!", ephemeral=True)

class MatchView(discord.ui.View):
    def __init__(self, matches):
        super().__init__(timeout=None)
        for num, p1, p2 in matches[:25]:
            self.add_item(MatchButton(num, p1, p2))

@bot.tree.command(name="قرعة", description="عمل قرعة مواجهات للبطولات")
@app_commands.describe(role="رتبة المشاركين", channel="روم النشر")
async def draw_matches(interaction: discord.Interaction, role: discord.Role, channel: discord.TextChannel):
    await interaction.response.defer(ephemeral=True)
    members = [m for m in role.members if not m.bot]

    if len(members) < 2:
        await interaction.followup.send("❌ عدد الأعضاء غير كافي للقرعة!", ephemeral=True)
        return

    random.shuffle(members)
    embed = discord.Embed(title=f"🏆 جدول قرعة - {role.name}", color=discord.Color.blue())

    matches_text = ""
    matches_data = []
    match_num = 1

    for i in range(0, len(members) - 1, 2):
        p1, p2 = members[i], members[i+1]
        matches_data.append((match_num, p1, p2))
        matches_text += f"⚔️ **المباراة #{match_num}**: {p1.mention} 🆚 {p2.mention}\n"
        match_num += 1

    if len(members) % 2 != 0:
        matches_text += f"\n⭐ **متأهل تلقائياً:** {members[-1].mention}"

    embed.description = matches_text
    await channel.send(embed=embed, view=MatchView(matches_data))
    await interaction.followup.send(f"✅ تم إرسال القرعة في {channel.mention}!", ephemeral=True)

