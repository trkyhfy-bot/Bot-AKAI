# 8. لعبة التكتيك والذكاء (شبكة 5x4)
# ================= ================= =================
BOARD_ROWS = 5
BOARD_COLS = 4

class TacticalBoardView(discord.ui.View):
    def __init__(self, player1: discord.Member, player2: discord.Member):
        super().__init__(timeout=300)
        self.p1 = player1
        self.p2 = player2
        self.turn = player1
        self.symbols = {player1.id: "🔴", player2.id: "🔵"}
        self.placed_count = {player1.id: 0, player2.id: 0}
        self.board = [["⬛" for _ in range(BOARD_COLS)] for _ in range(BOARD_ROWS)]
        self.selected_pos = None

        for r in range(BOARD_ROWS):
            for c in range(BOARD_COLS):
                button = discord.ui.Button(
                    label="\u200b", 
                    style=discord.ButtonStyle.secondary, 
                    row=r, 
                    custom_id=f"btn_{r}_{c}"
                )
                button.callback = self.make_callback(r, c)
                self.add_item(button)

    def make_callback(self, r, c):
        async def callback(interaction: discord.Interaction):
            await self.handle_click(interaction, r, c)
        return callback

    async def handle_click(self, interaction: discord.Interaction, r: int, c: int):
        if interaction.user.id != self.turn.id:
            await interaction.response.send_message("❌ ليس دورك الآن!", ephemeral=True)
            return

        user_id = interaction.user.id
        symbol = self.symbols[user_id]

        if self.placed_count[user_id] < 4:
            if self.board[r][c] != "⬛":
                await interaction.response.send_message("❌ هذا المربع مشغول!", ephemeral=True)
                return

            self.board[r][c] = symbol
            self.placed_count[user_id] += 1

            if self.check_win(symbol):
                self.disable_all()
                await interaction.response.edit_message(content=f"🎉 **مبروك! الفائز بالذكاء هو {self.turn.mention}!** 🏆", view=self)
                return

            self.switch_turn()
            await self.update_view(interaction)
        else:
            if self.selected_pos is None:
                if self.board[r][c] != symbol:
                    await interaction.response.send_message("❌ اختر قطعة من قطعك لنقلها!", ephemeral=True)
                    return
                self.selected_pos = (r, c)
                await interaction.response.send_message("🎯 تم تحديد القطعة! اضغط على أي مربع فارغ لنقلها إليه.", ephemeral=True)
            else:
                sr, sc = self.selected_pos
                if (r, c) == (sr, sc):
                    self.selected_pos = None
                    await interaction.response.send_message("🔄 تم إلغاء تحديد القطعة.", ephemeral=True)
                    return

                if self.board[r][c] != "⬛":
                    await interaction.response.send_message("❌ يجب نقل القطعة إلى مربع فارغ!", ephemeral=True)
                    return

                self.board[sr][sc] = "⬛"
                self.board[r][c] = symbol
                self.selected_pos = None

                if self.check_win(symbol):
                    self.disable_all()
                    await interaction.response.edit_message(content=f"🎉 **مبروك! الفائز بالذكاء هو {self.turn.mention}!** 🏆", view=self)
                    return

                self.switch_turn()
                await self.update_view(interaction)

    def switch_turn(self):
        self.turn = self.p2 if self.turn == self.p1 else self.p1

    def disable_all(self):
        for child in self.children:
            child.disabled = True

    async def update_view(self, interaction: discord.Interaction):
        for child in self.children:
            r = child.row
            c = int(child.custom_id.split("_")[2])
            cell = self.board[r][c]
            if cell == "⬛":
                child.label = "\u200b"
                child.emoji = None
                child.style = discord.ButtonStyle.secondary
            else:
                child.label = ""
                child.emoji = cell
                child.style = discord.ButtonStyle.primary if cell == "🔴" else discord.ButtonStyle.success

        p1_placed = self.placed_count[self.p1.id]
        p2_placed = self.placed_count[self.p2.id]
        
        status_text = (
            f"⚔️ **مباراة التكتيك والذكاء (5x4)**\n"
            f"🔴 {self.p1.mention} (القطع: {p1_placed}/4)\n"
            f"🔵 {self.p2.mention} (القطع: {p2_placed}/4)\n\n"
            f"👉 **الدور الحالي عند:** {self.turn.mention}\n"
            f"💡 *ضع 4 قطع أولاً، ثم حرك أي قطعة لمربع فارغ لتكون 3 قطع متتالية!*"
        )
        await interaction.response.edit_message(content=status_text, view=self)

    def check_win(self, s):
        for r in range(BOARD_ROWS):
            for c in range(BOARD_COLS - 2):
                if self.board[r][c] == s and self.board[r][c+1] == s and self.board[r][c+2] == s:
                    return True

        for r in range(BOARD_ROWS - 2):
            for c in range(BOARD_COLS):
                if self.board[r][c] == s and self.board[r+1][c] == s and self.board[r+2][c] == s:
                    return True

        for r in range(BOARD_ROWS - 2):
            for c in range(BOARD_COLS - 2):
                if self.board[r][c] == s and self.board[r+1][c+1] == s and self.board[r+2][c+2] == s:
                    return True

        for r in range(BOARD_ROWS - 2):
            for c in range(2, BOARD_COLS):
                if self.board[r][c] == s and self.board[r+1][c-1] == s and self.board[r+2][c-2] == s:
                    return True

        return False

@bot.tree.command(name="تحدي", description="بدء لعبة التكتيك والذكاء 4 قطع (شبكة 5x4)")
@app_commands.describe(opponent="اختر الخصم الذي تريد اللعب ضده")
async def challenge(interaction: discord.Interaction, opponent: discord.Member):
    await interaction.response.defer()

    if opponent.bot or opponent.id == interaction.user.id:
        await interaction.followup.send("❌ اختر خصماً صحيحاً (ليس بوت ولا نفسك)!", ephemeral=True)
        return

    view = TacticalBoardView(interaction.user, opponent)
    start_msg = (
        f"⚔️ **بدأت مباراة التكتيك والذكاء بين {interaction.user.mention} 🔴 و {opponent.mention} 🔵!**\n"
        f"الشبكة: **5x4** | الهدف: **تكوين 3 قطع متتالية**\n\n"
        f"👉 **الدور الأول عند:** {interaction.user.mention}"
    )
    await interaction.followup.send(start_msg, view=view)
