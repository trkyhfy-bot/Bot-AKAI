# 4. أمر إعطاء الرتب التقليدي (!رول @العضو)
# ================= ================= =================
TARGET_ROLE_ID = 1454210508684001355

@bot.command(name="رول", aliases=["رتبة"])
async def give_role(ctx, member: discord.Member = None):
    if not ctx.author.guild_permissions.manage_roles:
        await ctx.send("❌ لا تملك صلاحية إدارة الرتب لاستخدام هذا الأمر!")
        return

    if not member:
        await ctx.send("❌ طريقة الاستخدام: `!رول @العضو`")
        return

    role = ctx.guild.get_role(TARGET_ROLE_ID)

    if not role:
        await ctx.send("❌ لم يتم العثور على الرتبة في السيرفر!")
        return

    try:
        if role in member.roles:
            await member.remove_roles(role)
            await ctx.send(f"✅ تم إزالة الرتبة **{role.name}** من {member.mention}")
        else:
            await member.add_roles(role)
            await ctx.send(f"✅ تم إعطاء الرتبة **{role.name}** لـ {member.mention}")
    except discord.Forbidden:
        await ctx.send("❌ لا أملك صلاحيات كافية لتعديل رتبة هذا العضو!")

